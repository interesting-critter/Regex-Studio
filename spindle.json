{
  "version": "1.0.3",
  "name": "Regex Studio",
  "identifier": "regexstudio",
  "author": "Critter",
  "github": "https://github.com/interesting-critter/Regex-Studio",
  "homepage": "https://github.com/interesting-critter/Regex-Studio",
  "description": "Convert Character Cards, Lorebooks, or custom text into plain text to edit with regex find and replace.",
  "permissions": ["characters", "world_books"],
  "entry_backend": "dist/backend.js",
  "entry_frontend": "dist/frontend.js",
  "minimum_lumiverse_version": "0.1.0",
  "storage_seed_files": [
    { "from": "regex_presets.json", "to": "regex_presets.json" }
  ]
}
